# --- Identity -----------------------------------------------------------
# GitHub token (recommended: unauthenticated is 60 req/h per IP)
GITHUB_TOKEN=
# --- Private repositories (optional, GitHub App) -------------------------
# A personal GITHUB_TOKEN can read every private repo that user can read, which is
# the wrong boundary for a service that builds code. A GitHub App is scoped to the
# repos it is installed on, and GitHub enforces it — access is simply "is there an
# installation for this repo".
# Create an App, install it on the repos you want, then:
GITHUB_APP_ID=
# PEM contents (newlines may be written as \n) or a path to the .pem file.
# Never commit this key.
GITHUB_APP_PRIVATE_KEY=
# Optional: pin one installation instead of looking it up per repo.
GITHUB_APP_INSTALLATION_ID=
# --- Persistence (optional; in-memory by default) -----------------------
# Postgres for production durability. Without it, state is in-memory.
DATABASE_URL=postgres://tm:tm@localhost:5432/timemachine
# --- Queue (optional; in-process by default) ----------------------------
# Redis + BullMQ for multi-process builds. Without it builds run in-process.
REDIS_URL=redis://localhost:6379
# --- Behavior -----------------------------------------------------------
# runner: docker | local | auto
#   docker — builds run in an ephemeral, resource-capped, non-root container.
#   local  — DEV ONLY. Refused when NODE_ENV=production (see note below).
#   auto   — docker when available, else local; local is refused in production,
#            so `auto` fails closed (changelog-only, status=degraded).
TM_RUNNER=auto
# DANGER: re-enable executing untrusted repo code (npm lifecycle/build scripts,
# `npm start`) directly on this host. Only on a disposable VM with no secrets,
# no credentials on disk and no egress. Refused when NODE_ENV=production.
# TM_ALLOW_UNSAFE_LOCAL_EXEC=1
# hard build timeout (ms)
TM_BUILD_TIMEOUT_MS=180000
# ephemeral sandbox TTL (ms)
TM_SANDBOX_TTL_MS=600000
# base dir for trees/builds caches
TM_DATA_DIR=.data
# Public origin used for permalinks in exported Markdown. Set this behind a
# proxy/load balancer so reports don't capture an internal Host header.
TM_PUBLIC_URL=
# docker image for node/python builds
TM_NODE_IMAGE=node:20-bookworm-slim
TM_PYTHON_IMAGE=python:3.12-slim
# docker network for builds (create one with registry-only egress; see README)
TM_DOCKER_NETWORK=bridge
# --- Docker Engine API (no docker CLI required) --------------------------
# Builds talk to a daemon over its HTTP API, so the app host needs a reachable
# daemon but does NOT need docker installed. Point at a remote engine, a TLS
# endpoint, or a local socket.
#   TM_DOCKER_HOST=tcp://build-host:2375        (plain, trusted network only)
#   TM_DOCKER_HOST=https://build-host:2376      (TLS)
#   TM_DOCKER_HOST=unix:///var/run/docker.sock  (local daemon)
TM_DOCKER_HOST=tcp://127.0.0.1:2375
TM_DOCKER_TOKEN=
# Address the preview container's port is published on, ON THE DAEMON HOST.
# 127.0.0.1 (default) keeps the untrusted preview unreachable from the network,
# so it only works if this app can reach the daemon's loopback. Widening this
# publishes a stranger's `npm start` to anyone who can reach the host.
TM_DOCKER_PREVIEW_BIND=127.0.0.1
# Container port the preview server listens on inside the container.
TM_DOCKER_PREVIEW_PORT=3000
# How long to wait for a preview container to accept connections (npm ci is slow).
TM_PREVIEW_READY_TIMEOUT_MS=120000
TM_DOCKER_TLS_VERIFY=1
TM_DOCKER_CA=
# concurrency of in-process builds
TM_CONCURRENCY=2
# Fail a snapshot stranded in queued/analyzing/building past this deadline — the
# process running it died without ever marking it failed.
TM_STALE_SNAPSHOT_MS=900000
TM_REAPER_INTERVAL_MS=60000
# Delete terminal snapshots older than this (days). 0 disables retention.
TM_SNAPSHOT_RETENTION_DAYS=90
# Global ceiling on outbound GitHub API calls, so this deployment cannot drain
# its own GITHUB_TOKEN quota regardless of client count. Refill is per minute.
TM_GITHUB_BUDGET=4000
TM_GITHUB_BUDGET_REFILL=70
# --- External API overrides (self-host/proxy/testing) -------------------
TM_GITHUB_API_BASE=https://api.github.com
TM_OSV_BASE=https://api.osv.dev
TM_NPM_REGISTRY_BASE=https://registry.npmjs.org
# --- Observability ------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
